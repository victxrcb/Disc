# Supabase (Realtime é usado para sinalização WebRTC, presença e chat — nenhuma tabela é necessária)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# URL publica do site, usada ao copiar convites dentro do aplicativo desktop.
VITE_PUBLIC_APP_URL=https://disc-call.vercel.app

# TURN opcional (ajuda quando a conexão direta entre redes falha). Pode listar várias URLs separadas por vírgula.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Aplique supabase/migrations/202610300001_social_profiles.sql no projeto Supabase.
